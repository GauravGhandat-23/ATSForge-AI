# ============================================================
#  ATSForge AI — Vercel Production Environment Variables
#  Configure these directly in the Vercel Project Settings:
#  Project Settings -> Environment Variables
# ============================================================

# --- Vercel Serverless Postgres Database ---
# Automatically populated when you connect Vercel Postgres / Neon Storage
POSTGRES_URL=
DATABASE_URL=

# --- Google OAuth 2.0 / OpenID Connect ---
# Obtain from Google Cloud Console: Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Session Security ---
# Strong cryptographic secret (32+ chars) used for signing HttpOnly session cookies
AUTH_SECRET=

# Production canonical domain URL (e.g. https://your-project.vercel.app)
# If omitted on Vercel, ATSForge AI automatically infers VERCEL_URL
AUTH_URL=

# --- Vercel Blob File Storage (Optional) ---
# Automatically populated when you attach Vercel Blob Storage in the Vercel dashboard
BLOB_READ_WRITE_TOKEN=

# --- AI Provider Configuration ---
# Supported providers: "gemini" | "openai" | "groq" | "anthropic"
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash
