# ============================================================
#  ATSForge AI — Production Environment Variables (Vercel)
#  Configure these directly in your Vercel Project Settings:
#  Settings -> Environment Variables
# ============================================================

# --- Neon PostgreSQL Database ---
# Automatically populated when Neon is connected via Vercel integration
DATABASE_URL=
POSTGRES_URL=

# --- Real Google OAuth 2.0 / OpenID Connect ---
# Obtain from Google Cloud Console (Credentials -> OAuth 2.0 Client IDs)
# Authorized JavaScript origin: https://ats-forge-ai.vercel.app (and http://localhost:3000 for local dev)
# Authorized redirect URI:      https://ats-forge-ai.vercel.app/auth/callback (and http://localhost:3000/auth/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Session Security ---
# Strong cryptographic secret (32+ characters) used for signing HttpOnly session cookies
AUTH_SECRET=

# --- Application & Callback URLs ---
# Production application origin URL
AUTH_URL=https://ats-forge-ai.vercel.app

# Explicit OAuth Callback URL for Google OAuth 2.0
AUTH_CALLBACK_URL=https://ats-forge-ai.vercel.app/auth/callback

# --- AI Provider Configuration ---
# Supported providers: "gemini" | "openai" | "groq" | "anthropic"
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# --- Vercel Blob File Storage (Optional) ---
# Automatically populated when you attach Vercel Blob storage
BLOB_READ_WRITE_TOKEN=
